# Copia este archivo como .env y pon tus datos reales.
# El .env NO se sube a GitHub (está en .gitignore).

# Correo para los recordatorios (Gmail con contraseña de aplicación)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=tu_clave_de_16_letras
# Opcional: remitente que se muestra (por defecto, MAIL_USERNAME)
MAIL_FROM=

# Opcional: dirección pública de la app, para los botones del correo
APP_URL=

# Opcional: administrador que se crea solo al arrancar si todavía no existe.
# Solo ve el panel /admin. Contraseña con mayúscula, minúscula, número y símbolo.
ADMIN_USUARIO=
ADMIN_CONTRASENA=
